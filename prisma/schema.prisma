// 여행 보드 스키마
// Postgres(Neon)를 로컬·배포 모두에서 사용합니다. 연결 문자열은 DATABASE_URL 하나로 관리.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // 앱 쿼리는 pgbouncer 커넥션 풀을 거치고,
  // 마이그레이션은 풀을 통과하면 실패하므로 직접 연결을 따로 쓴다 (Neon이 둘 다 준다).
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Post {
  id         String    @id @default(cuid())
  title      String
  place      String?
  category   String    @default("dessert")
  memo       String?
  linkUrl    String?
  authorName String
  visitedAt  DateTime?
  createdAt  DateTime  @default(now())

  images    PostImage[]
  comments  Comment[]
  reactions Reaction[]
  wishes    Wish[]

  @@index([createdAt])
  @@index([category])
}

/// 한 글에 사진 여러 장. sort 순서대로 보여준다. 사진 없는 글도 허용.
model PostImage {
  id     String @id @default(cuid())
  postId String
  url    String
  width  Int?
  height Int?
  sort   Int    @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, sort])
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  authorName String
  body       String
  createdAt  DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Reaction {
  id        String   @id @default(cuid())
  postId    String
  userKey   String
  emoji     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userKey, emoji])
  @@index([postId])
}

model Wish {
  id        String   @id @default(cuid())
  postId    String
  userKey   String
  userName  String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userKey])
  @@index([postId])
}

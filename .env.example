# Neon Postgres (Vercel > Storage 에서 Neon을 프로젝트에 연결하면 자동 주입됩니다)
# 로컬에서는 `vercel env pull .env` 로 받아오세요.
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# 마이그레이션용 직접 연결. pgbouncer를 거치면 스키마 변경이 실패해서 따로 씁니다.
DATABASE_URL_UNPOOLED="postgres://user:password@host/db?sslmode=require"

# Vercel Blob 토큰. 배포 환경에는 자동 주입됩니다.
# 로컬에서 비워두면 public/uploads 폴더에 저장합니다 (배포 환경에서는 동작하지 않음).
BLOB_READ_WRITE_TOKEN=""
